DATAHUB_VERSION=v1.5.0.6
DATAHUB_GRAPHQL_URL=http://localhost:19002/api/graphql
DATAHUB_TOKEN=
DATAHUB_ENV=DEV

# DataHub database target selection
# Options: local | shared | branch
DATABASE_TARGET=local

# Reuse existing StreetScore database URLs whenever possible.
# The prepare script will parse the selected URL and generate generic DataHub values.
# DATABASE_URL=postgresql://username@localhost:5432/databasename
# NEON_SHARED_DATABASE_URL=postgresql://username:password@your-neon-host/neondb?sslmode=require&channel_binding=require
# NEON_BRANCH_DATABASE_URL=postgresql://username:password@your-branch-host/neondb?sslmode=require&channel_binding=require

# Optional explicit per-target overrides.
# These are only needed if you do not want to reuse the existing StreetScore URLs.
LOCAL_POSTGRES_HOST=
LOCAL_POSTGRES_PORT=5432
LOCAL_POSTGRES_DATABASE=
LOCAL_POSTGRES_USERNAME=
LOCAL_POSTGRES_PASSWORD=

NEON_SHARED_HOST=
NEON_SHARED_PORT=5432
NEON_SHARED_DATABASE=
NEON_SHARED_USERNAME=
NEON_SHARED_PASSWORD=

NEON_BRANCH_HOST=
NEON_BRANCH_PORT=5432
NEON_BRANCH_DATABASE=
NEON_BRANCH_USERNAME=
NEON_BRANCH_PASSWORD=

# Generated by `npm run datahub:prepare-env`.
# Do not edit these manually.
# POSTGRES_HOST=
# POSTGRES_PORT=
# POSTGRES_DATABASE=
# POSTGRES_USERNAME=
# POSTGRES_PASSWORD=
# POSTGRES_SSLMODE=